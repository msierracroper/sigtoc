# Copia este archivo a .env.local para desarrollo local (no lo subas a git).
# En Vercel: Project Settings -> Environment Variables, agrega estas tres.
# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Clave pública VAPID (la privada va en los secretos de la Edge Function sla-push-check)
VITE_VAPID_PUBLIC_KEY=<vapid public key>
