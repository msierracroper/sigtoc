# Copiar como backup.env (NO se sube a git: contiene la clave de servicio, que da acceso total).
# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Carpeta destino. Usar una carpeta de Google Drive para escritorio para tener copia en la nube,
# por ejemplo: G:\Mi unidad\SIGTOC-respaldos
BACKUP_DIR=C:\SIGTOC-respaldos

# Cuántas exportaciones de tablas conservar (los archivos se conservan todos)
KEEP_EXPORTS=12
